{
  "name": "dsh-persona-manage",
  "description": "Persona prompt management for the DSH web GUI: a settings page (设置 → Persona 提示词) that edits the deployment-level system-prompt persona live — textarea editor, {{variable}} strict-template lint, token/size stats, save writes the settings namespace (hot-applied, no host restart).",
  "version": "0.1.1",
  "type": "module",
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-settings"
      ],
      "platform": "web"
    }
  },
  "peerDependencies": {
    "react": "^18.2.0"
  },
  "files": [
    "lib/**/*.js",
    "cordis.patch.yml",
    "README.md"
  ],
  "keywords": [
    "dsh",
    "deepseek-harness",
    "persona",
    "system-prompt",
    "plugin"
  ],
  "license": "MIT"
}
